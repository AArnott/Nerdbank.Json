<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <PublishNativeAOTTests>false</PublishNativeAOTTests>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
        <PackageReference Include="PolyType" />
        <PackageReference Include="TUnit.Engine" />
        <PackageReference Include="xunit.v3.assert.aot" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))" />
        <PackageReference Include="xunit.v3.assert" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Nerdbank.Json.Analyzers\Nerdbank.Json.Analyzers.csproj" />
        <ProjectReference Include="..\..\src\Nerdbank.Json\Nerdbank.Json.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Projects with their own version.json. AssemblyVersionTests verifies that it (not the root version.json) determines their assembly version. -->
        <NestedVersionJsonProject Include="..\..\src\Nerdbank.Json.Analyzers\Nerdbank.Json.Analyzers.csproj" />
    </ItemGroup>
</Project>
