<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace />
    <PublishNativeAOTTests>false</PublishNativeAOTTests>
    <NoWarn>$(NoWarn);SA1601</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nerdbank.Json.AspNetCoreMvcFormatter\Nerdbank.Json.AspNetCoreMvcFormatter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolyType" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="10.0.1*" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="11.0.0-rc.3.26522.148" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))">
    <PackageReference Include="xunit.v3.assert.aot" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))">
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

</Project>
